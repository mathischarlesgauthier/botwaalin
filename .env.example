# --- WhatsApp Cloud API (Meta Graph v21) ---
# Jeton d'accès permanent (system user Meta Business) ou temporaire (24 h, dev)
WHATSAPP_TOKEN=
# ID du numéro de téléphone WhatsApp Business (pas le numéro lui-même)
PHONE_NUMBER_ID=
# Jeton de vérification du webhook (choisi par toi, recopié dans la console Meta)
VERIFY_TOKEN=
# App Secret Meta (Paramètres de l'app > Général) — vérification X-Hub-Signature-256
APP_SECRET=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Notification admin Telegram (handoff) ---
# Chat ID Telegram de l'admin (obtenu via @userinfobot)
ADMIN_TG_CHAT_ID=
# Jeton du bot Telegram qui envoie les notifications (obtenu via @BotFather)
TELEGRAM_BOT_TOKEN=

# --- Optionnel ---
# PORT=3000
# DB_PATH=data/agent.db
# CATALOGUE_PATH=data/catalogue.md
# LOG_LEVEL=info
# DEBOUNCE_MS=2500
# GRAPH_API_BASE=https://graph.facebook.com/v21.0
